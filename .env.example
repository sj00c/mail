# Google Cloud OAuth client credentials (Web application type)
# 발급 방법은 docs/OAUTH_SETUP.md 참고 (클론 후 처음 한 번, 각자 본인 것).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Where Google redirects after consent. Must match the Authorized redirect URI
# you registered in Google Cloud Console exactly.
OAUTH_REDIRECT=http://localhost:8787/auth/callback

# Backend port
PORT=8787

# Bind address. 기본 127.0.0.1 (이 머신 전용). 이 앱은 요청 인증이 없으므로
# LAN에 노출(0.0.0.0)하지 말 것 — 같은 망의 누구나 메일을 읽고 보낼 수 있게 된다.
# HOST=127.0.0.1
