# Google Cloud OAuth client credentials (Web application type)
# 발급 방법은 README.md의 "Google 연결 준비" 참고 (처음 한 번, 각자 본인 것).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Where Google redirects after consent. Must match the Authorized redirect URI
# you registered in Google Cloud Console exactly. 포트는 아래 PORT와 같아야 한다.
OAUTH_REDIRECT=http://localhost:8787/auth/callback

# Backend port. 8787을 다른 프로그램이 쓰면 비어 있는 번호로 바꾸되(1024~65535),
# 위 OAUTH_REDIRECT의 포트도 같이 바꾸고 그 URI를 Google Cloud 콘솔에 등록할 것.
PORT=8787

# Bind address. 기본 127.0.0.1 (이 머신 전용). 직접 실행 시 localhost와 ::1도 허용.
# 설치기는 127.0.0.1을 사용하며, 서버는 0.0.0.0 등 외부 바인딩을 거부한다.
# HOST=127.0.0.1

# 배포용(개발자만, 선택): npm 패키지에 넣을 "데스크톱 앱" 유형 OAuth 클라이언트.
# 설정하면 사용자는 Client ID·Secret 입력 없이 로그인만 한다(setup이 사용자 .env에 채움).
# 비워 두면 사용자가 각자 발급해 입력한다. CI는 같은 이름의 저장소 secret을 쓴다.
# BUNDLED_GOOGLE_CLIENT_ID=
# BUNDLED_GOOGLE_CLIENT_SECRET=
