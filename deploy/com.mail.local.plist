<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 경로(__RUN__/__BUN__/__DIR__/__LOG__)는 deploy/install.sh가 설치 시점에 치환한다. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mail.local</string>

  <key>ProgramArguments</key>
  <array>
    <string>__RUN__</string>
    <string>__BUN__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__DIR__</string>

  <!-- 로그인 시 자동 시작 -->
  <key>RunAtLoad</key>
  <true/>

  <!-- 비정상 종료 시 자동 재시작 (sleep 중에는 프로세스가 일시정지될 뿐
       종료가 아니므로 깨어나면 그대로 재개된다) -->
  <key>KeepAlive</key>
  <true/>

  <!-- 크래시 루프 시 과도한 재시작 방지 -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
