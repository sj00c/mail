{
  "name": "@sj00c/mail",
  "version": "0.1.0",
  "description": "Local Gmail, Calendar, Drive and Contacts app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sj00c/mail.git"
  },
  "homepage": "https://github.com/sj00c/mail#readme",
  "bugs": "https://github.com/sj00c/mail/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.14"
  },
  "bin": {
    "sj-mail": "cli/mail.mjs"
  },
  "files": [
    "cli/mail.mjs",
    "server/**/*.ts",
    "!server/**/*.test.ts",
    "dist/index.html",
    "dist/assets/**",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "bun --use-system-ca --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "prepack": "bun run build",
    "check:package": "node scripts/check-package.mjs",
    "start": "node cli/mail.mjs start",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "bun run test:unit",
    "check": "bun run test:unit && bun run typecheck && bun run test:e2e:production",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e:production": "bun run build && bun run test:e2e"
  },
  "dependencies": {
    "@googleapis/calendar": "9.8.0",
    "@googleapis/drive": "12.1.0",
    "@googleapis/gmail": "^12.0.1",
    "@googleapis/people": "3.0.9",
    "google-auth-library": "^9.15.1",
    "hono": "4.13.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "10.0.4",
    "jsdom": "26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "nanoid": "^3.3.17",
    "postcss": "^8.5.26",
    "uuid": "^11.1.1"
  }
}
