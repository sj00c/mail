{
  "name": "mail-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "bun --use-system-ca --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production bun --use-system-ca server/index.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "bun run test:unit",
    "check": "bun run test:unit && bun run typecheck && bun run test:e2e:production",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e:production": "bun run build && bun run test:e2e"
  },
  "dependencies": {
    "@googleapis/calendar": "9.8.0",
    "@googleapis/drive": "12.1.0",
    "@googleapis/gmail": "^12.0.1",
    "@googleapis/people": "3.0.9",
    "google-auth-library": "^9.15.1",
    "hono": "4.13.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "10.0.4",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "^3.3.17",
    "postcss": "^8.5.26",
    "uuid": "^11.1.1"
  }
}
